# Copy to .env — never commit .env. Use your hosting panel or CI to inject secrets.

# --- Environment ---
# Local WAMP/XAMPP:
# APP_ENV=local
# APP_DEBUG=1
# APP_BASE_URL=/vk
#
# cPanel production:
# APP_ENV=production
# APP_DEBUG=0
# APP_BASE_URL=https://your-domain.com
APP_ENV=production
APP_DEBUG=0
APP_BASE_URL=https://your-domain.com

# --- Performance cache (optional) ---
# VK_CACHE_DRIVER=file
# VK_DASHBOARD_CACHE_TTL=30
# VK_CACHE_DRIVER=redis
# VK_REDIS_HOST=127.0.0.1
# VK_REDIS_PORT=6379
# VK_REDIS_PASS=
# VK_PERF_HEADERS=1

# --- Database (cPanel MySQL) ---
VK_DB_HOST=localhost
VK_DB_NAME=cpaneluser_vk_billing
VK_DB_USER=cpaneluser_vk_user
VK_DB_PASS=your_cpanel_db_password

# --- One-time automated setup (setup/email-auto-config.php) ---
# Required to call GET/POST setup with ?token= matching this value.
VK_SETUP_SECRET=change-me-to-a-long-random-string

# --- vkitnet.info hosted mail (SSL + auth on all services) ---
# SMTP 465 SSL | IMAP 993 SSL | POP3 995 SSL
# IMPORTANT: Do not duplicate MAIL_* / VK_SMTP_* keys. First occurrence wins.
# Quote passwords that contain $ { } # or spaces.
# --- Outbound SMTP (VK_* preferred; Laravel MAIL_* also supported) ---
VK_SMTP_HOST=mail.vkitnet.info
VK_SMTP_PORT=465
VK_SMTP_USER=info@vkitnet.info
# Use double quotes if the password contains $ { } # or spaces, e.g. VK_SMTP_PASS="your{pass}$here"
VK_SMTP_PASS=
VK_SMTP_SECURE=ssl
# If Windows/WAMP fails SSL verify: VK_SMTP_RELAX_SSL=1 (less secure — use only for local debug)
VK_SMTP_RELAX_SSL=1
VK_MAIL_FROM=info@vkitnet.info
VK_MAIL_FROM_NAME="VK IT Network"

# Laravel-compatible names (must match VK_* passwords — no conflicting duplicates)
MAIL_MAILER=smtp
MAIL_HOST=mail.vkitnet.info
MAIL_PORT=465
MAIL_USERNAME=info@vkitnet.info
# Quote if password contains $ { } # — e.g. MAIL_PASSWORD="your{pass}$"
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=info@vkitnet.info
MAIL_FROM_NAME="VK IT Network"

# --- Inbound IMAP (993 SSL) ---
VK_IMAP_HOST=mail.vkitnet.info
VK_IMAP_PORT=993
VK_IMAP_USER=info@vkitnet.info
VK_IMAP_PASS=
VK_IMAP_ENABLED=1

# --- Cron (IMAP poll + queue) ---
VK_CRON_SECRET=change-me-to-a-long-random-string
